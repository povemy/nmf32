# ============================================================
# NOMOFEE — environment template (NO secrets — copy to .env)
# The dev server auto-restores .env from upload/.env.vault at
# boot via scripts/ensure-env.ts + src/instrumentation.ts.
# ============================================================

# Primary app database — Supabase Postgres via Supavisor session pooler (IPv4)
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=10&connect_timeout=10
SUPABASE_DATABASE_URL=

# Supabase project API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: direct (non-pooled) connection — IPv6-only endpoint, docs/ops only
# DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ------------------------------------------------------------
# SECURITY SECRETS (F-04/F-23 remediation → P2.3-7 boot gate)
# BOOT-FATAL IN PRODUCTION (src/instrumentation-node.ts →
# enforceProductionSecrets): a missing PSP_WEBHOOK_SECRET, CRON_SECRET,
# MFA_ENCRYPTION_KEY, IMPORT_TOKEN_ENC_KEY, ORDER_ACCESS_SECRET,
# EMAIL_OTP_SECRET or EMAIL_PROVIDER block ABORTS the production server
# boot with an explicit list of what is missing (Phase 2.3 audit:
# "production boot should fail clearly when mandatory secrets are missing").
# The remaining secrets below are WARN-at-boot + FAIL CLOSED at their
# protected endpoint when unset (the endpoint rejects instead of accepting
# unsigned/forged events). Sandbox/dev falls back to documented public demo
# values so the mock rails keep working — production MUST set real,
# high-entropy values.
# ------------------------------------------------------------

# HMAC-SHA256 signing secret for payment/payout webhook events
# (X-SM-Signature) — required in production for
# POST /api/webhooks/payments/[provider] and the simulate rails.
# Generate e.g.: openssl rand -hex 32
PSP_WEBHOOK_SECRET=

# Shared secret for the cron tick endpoints (x-cron-secret header)
# POST /api/cron/* and GET /api/health/scheduler — required in production
# (503 CRON_SECRET_UNSET / CRON_NOT_CONFIGURED otherwise).
# Generate e.g.: openssl rand -hex 32
CRON_SECRET=

# AES key for admin MFA secret encryption at rest (src/lib/mfa.ts).
# Any non-empty string; sha256(key) is the AES-256-GCM key. Unset FAILS
# CLOSED in production: admin MFA enrollment/verification answers
# 503 MFA_NOT_CONFIGURED. Dev falls back to a one-time-warned default key.
# Generate e.g.: openssl rand -hex 32
MFA_ENCRYPTION_KEY=

# HMAC secret for the short-lived `import_cap` cookie that authorises
# marketplace import job creation (src/lib/import-cap.ts). Unset FAILS
# CLOSED in production (503 IMPORT_CAP_SECRET_UNSET). Dev falls back to a
# documented public demo constant.
# Generate e.g.: openssl rand -hex 32
IMPORT_CAP_SECRET=

# Bearer token protecting GET /api/metrics — unset = metrics disabled (503).
METRICS_TOKEN=

# HMAC-SHA256 signing secret for shipping tracking webhooks
# (x-shipping-signature header) — POST /api/shipping/webhook/[provider].
# Required in production; replay window ±10 min.
SHIPPING_WEBHOOK_SECRET=

# Shared secret authorising the Next.js server → chat-relay broadcasts
# (x-chat-relay-secret header, chat-service :3103 /broadcast).
# Required in production; dev falls back to a documented demo value.
CHAT_RELAY_SECRET=

# AES key for marketplace OAuth token encryption (secretbox).
# Any string ≥16 chars. Unset FAILS CLOSED in production: seal/openSecret
# throw 503 SECRETBOX_NOT_CONFIGURED (encrypted token storage disabled).
# Dev falls back to a derived dev-only key with a console warning.
IMPORT_TOKEN_ENC_KEY=

# ------------------------------------------------------------
# FINAL CLOSURE — guest-order OTP + shopper email verification
# (src/lib/guest-otp.ts). Both FAIL CLOSED in production when unset
# (and are BOOT-FATAL, see the security block above):
# /api/orders/otp/* and /api/auth/shopper/email-verification/* answer 503,
# order lookup/receipt accept only OWNING sessions, and guest-order claiming
# stays disabled. Dev falls back to documented demo constants.
# Generate e.g.: openssl rand -hex 32
# ------------------------------------------------------------
# HMAC key for email-OTP challenge hashes (keyed hash of the 6-digit code).
EMAIL_OTP_SECRET=

# HMAC key for short-lived order-access grants (15-min, order-specific).
# Separate from EMAIL_OTP_SECRET so either can rotate independently.
ORDER_ACCESS_SECRET=

# ------------------------------------------------------------
# TRANSACTIONAL EMAIL PROVIDER (Phase 2.3 — IMPLEMENTED).
# MANDATORY IN PRODUCTION (boot-fatal since P2.3-7: guest-order OTP +
# email verification + claiming all depend on transactional email).
# Implemented providers:
#   resend  — production provider (verified 2026-11-06: native idempotency
#             keys, Svix-signed webhooks, Tokyo region). Requires
#             RESEND_API_KEY + EMAIL_FROM; missing config keeps every OTP
#             route fail-closed (503 EMAIL_PROVIDER_NOT_CONFIGURED).
#   mailpit — DEV-ONLY local catcher (run Mailpit on :8025); ignored in
#             production (boot aborts if selected — dev-only provider).
# Unset EMAIL_PROVIDER aborts the production boot.
# ------------------------------------------------------------
# EMAIL_PROVIDER=resend
# EMAIL_FROM=NOMOFEE <no-reply@mail.nomofee.com>
# RESEND_API_KEY=re_...            # "Sending access" key — never commit
# RESEND_WEBHOOK_SECRET=whsec_...  # Svix signing secret for
#                                  # POST /api/webhooks/email/resend
#                                  # (delivery events + suppression sync;
#                                  #  503 fail-closed in production if unset)
# MAILPIT_URL=http://127.0.0.1:8025  # only when EMAIL_PROVIDER=mailpit

# ------------------------------------------------------------
# OPTIONAL PROVIDER KEYS (production plug-in points — see src/lib/psp.ts)
# Unset adapters are never selected and never call the network.
# NOTE (Phase 2.3 PSP research): for a MALAYSIAN multi-vendor marketplace the
# recommended primary is CURLEC (Route: linked seller accounts + split-at-
# charge transfers, MYR) with CHIP-IN as the collect+disburse alternative;
# Stripe MY lacks MY connected accounts for a MY platform. PSP selection is
# an OWNER DECISION — adapters are implemented only after authorization.
# ------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# CURLEC_KEY_ID=...
# CURLEC_KEY_SECRET=...
# CURLEC_WEBHOOK_SECRET=...
# CHIP_API_KEY=...
# CHIP_WEBHOOK_PUBLIC_KEY_ID=...

# ------------------------------------------------------------
# OPTIONAL SEED ACCOUNT SECURITY
# Production deployments MUST override the seeded admin passwords.
# Unset → documented dev/demo passwords (fine for sandbox only).
# ------------------------------------------------------------
# SEED_ADMIN_PASSWORD=
# SEED_OPS_PASSWORD=
# SEED_FINANCE_PASSWORD=
# SEED_MODERATOR_PASSWORD=

# Checkout latency instrumentation flag
CHECKOUT_TIMING=1

# ------------------------------------------------------------
# DEVELOPMENT-ONLY LOGIN CREDENTIAL PANEL (P12)
# Shows the "Development Test Accounts — Sandbox Only" panel at the bottom
# of the unified login modal. Requires BOTH conditions (fail-closed):
#   NODE_ENV === "development"  AND  NOMOFEE_SHOW_DEV_LOGIN_CREDENTIALS === "true"
# When unset/false the panel and its API (GET /api/auth/dev-accounts) do not
# exist for the client (404). NEVER set in production or staging.
# Cleanup when development finishes: remove this flag, then follow
# docs/auth/unified-login-implementation-report.md §Demo-account cleanup.
# NOMOFEE_SHOW_DEV_LOGIN_CREDENTIALS=true
