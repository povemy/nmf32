:81 {
        # ----------------------------------------------------------------------------
        # Phase 2.3 (P2.3-6) — security response headers live in the APP
        # (next.config.ts headers()), NOT here. This site block is PLAIN HTTP
        # (:81) — it is not the TLS terminator, so HSTS emitted here would be
        # ignored by browsers, and duplicating nosniff/CSP here would create a
        # second authority that can drift from the app's policy. The sandbox's
        # TLS is terminated upstream at the platform edge; a self-hosted TLS
        # deployment would move termination INTO Caddy like this (uncomment and
        # give the site a domain):
        #
        #   example.com {
        #       encode zstd gzip
        #       header Strict-Transport-Security "max-age=31536000"
        #       reverse_proxy localhost:3000 { ...same header_up block... }
        #   }
        #
        # (If that block is ever enabled, remove Strict-Transport-Security from
        # next.config.ts so the value is set in exactly one place.)
        # ----------------------------------------------------------------------------
        # F-06 remediation — the XTransformPort proxy is RESTRICTED to the two
        # intended PUBLIC services:
        #   :3000 — the Next.js webapp (also the default route below)
        #   :3003 — the chat socket.io hub (browser clients connect via
        #           /?XTransformPort=3003 with an authenticated handshake)
        # Internal-only ports (:3103 chat relay, :3005 scheduler, :3002 dev)
        # must NOT be publicly routable — previously ANY localhost port was
        # proxied (audit F-06). A request carrying any other XTransformPort
        # value falls through to the default handler (the webapp itself).
        @chat query XTransformPort=3003

        handle @chat {
                reverse_proxy localhost:3003 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }

        handle {
                reverse_proxy localhost:3000 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }
}
