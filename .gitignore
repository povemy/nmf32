# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# secrets — never commit
.env
.env.*
!.env.example
upload/.env.vault
# Phase 3 hygiene: sandbox auto-snapshot must not capture scratch/backup areas
# (already-tracked files remain tracked until an authorized cleanup commit)
.agent-tmp/
tool-results/
download/
db/backup/
.next-staging/
.next-prod/
# Work Orders 1&2 hygiene (2026-12): local SQLite scratch DB (contains Session/
# AdminUser/Seller/KycDocument tables — dev fixtures, never source material)
# and mini-service runtime state must never enter a future commit.
db/*.db
db/*.sqlite
mini-services/*/state.json

# Work order 14 — runtime campaign media uploads (dev-served; not source)
public/uploads/campaigns/*
!public/uploads/campaigns/.gitkeep
