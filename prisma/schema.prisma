generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Plan {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  monthlyFeeMinor   Int      @default(0)
  commissionPercent Float?
  productLimit      Int?
  mediaLimitMb      Int?
  staffLimit        Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CommissionSetting {
  id                      Int     @id @default(autoincrement())
  defaultPercent          Float   @default(8.0)
  appliesToShipping       Boolean @default(false)
  basePriceRule           String  @default("paid_price")
  fixedFeeMinor           Int     @default(0)
  minCommissionMinor      Int     @default(0)
  payoutHoldDays          Int     @default(7)
  holdReleaseRule         String  @default("days_after_paid")
  graceDaysAfterDelivered Int     @default(2)
}

model CommissionOverride {
  id            String    @id @default(cuid())
  scope         String
  categoryId    String?
  sellerId      String?
  productId     String?
  percent       Float?
  fixedFeeMinor Int?
  holdDays      Int?
  validFrom     DateTime?
  validTo       DateTime?
  isActive      Boolean   @default(true)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FeeHoliday {
  id        String   @id @default(cuid())
  name      String
  scope     String   @default("all")
  scopeIds  String?
  percent   Float    @default(0)
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    @default("ops")
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Seller {
  id                        String        @id @default(cuid())
  email                     String        @unique
  passwordHash              String
  fullName                  String
  displayName               String
  countryCode               String        @default("MY")
  phone                     String?
  status                    String        @default("onboarding")
  riskTier                  String        @default("low")
  commissionOverridePercent Float?
  holdDaysOverride          Int?
  kycStatus                 String        @default("pending")
  planCode                  String        @default("free")
  marketplaceOptIn          Boolean       @default(true)
  rejectReason              String?
  submittedAt               DateTime?
  approvedAt                DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  bankAccounts              BankAccount[]
  kycDocuments              KycDocument[]
  sellerNotes               SellerNote[]
  store                     Store?
  wallet                    Wallet?
}

model KycDocument {
  id           String    @id @default(cuid())
  sellerId     String
  docType      String
  fileName     String
  status       String    @default("pending")
  rejectReason String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  seller       Seller    @relation(fields: [sellerId], references: [id])
}

model SellerNote {
  id        String   @id @default(cuid())
  sellerId  String
  author    String
  body      String
  createdAt DateTime @default(now())
  seller    Seller   @relation(fields: [sellerId], references: [id])
}

model Session {
  token     String   @id @default(cuid())
  userType  String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ShopperUser {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  fullName        String
  username        String?        @unique
  avatarUrl       String?
  membershipLevel String         @default("SILVER")
  followingCount  Int            @default(0)
  followerCount   Int            @default(0)
  phone           String?
  status          String         @default("active")
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  addresses       Address[]
  carts           Cart?
  chatThreads     ChatThread[]
  orders          Order[]
  paymentGroups   PaymentGroup[]
  wallet          ShopperWallet?
  activities      UserActivity[]
  vouchers        UserVoucher[]
  follows         StoreFollow[]
  notifications   Notification[]
}

model ChatThread {
  id            String        @id @default(cuid())
  shopperId     String
  storeId       String
  orderNumber   String?
  orderId       String?
  contextType   String?
  productId     String?
  subject       String?
  shopperUnread Int           @default(0)
  sellerUnread  Int           @default(0)
  createdAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]
  product       Product?      @relation(fields: [productId], references: [id])
  store         Store         @relation(fields: [storeId], references: [id])
  shopper       ShopperUser   @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  @@unique([shopperId, storeId])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  senderType String
  senderName String
  body       String
  createdAt  DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model Store {
  id               String                  @id @default(cuid())
  sellerId         String?                 @unique
  name             String
  slug             String                  @unique
  tagline          String?
  logoUrl          String?
  bannerUrl        String?
  description      String?
  status           String                  @default("draft")
  lifecycleSource  String                  @default("native")
  currency         String                  @default("MYR")
  timezone         String                  @default("Asia/Kuala_Lumpur")
  themeJson        String                  @default("{}")
  supportEmail     String?
  supportPhone     String?
  whatsapp         String?
  socialJson       String                  @default("{}")
  templateKey      String                  @default("aurora")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  apiKeys          ApiKey[]
  chatThreads      ChatThread[]
  pages            CmsPage[]
  collections      Collection[]
  coupons          Coupon[]
  importJobs       ImportJob[]
  connections      MarketplaceConnection[]
  orders           Order[]
  products         Product[]
  followers        StoreFollow[]
  vouchers         Voucher[]
  fsPriceAdjustMinor Int                    @default(0) // seller-funded free-shipping cost recovery (v1)
  seller           Seller?                 @relation(fields: [sellerId], references: [id])
  claims           StoreClaim[]
  domains          StoreDomain[]
  integrations     StoreIntegration[]
  webhookEndpoints WebhookEndpoint[]
}

model StoreDomain {
  id            String    @id @default(cuid())
  storeId       String
  domain        String    @unique
  mode          String    @default("cname")
  status        String    @default("pending")
  sslStatus     String    @default("pending")
  isPrimary     Boolean   @default(false)
  lastCheckedAt DateTime?
  errorReason   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  store         Store     @relation(fields: [storeId], references: [id])
}

model CmsPage {
  id               String   @id @default(cuid())
  storeId          String
  slug             String
  title            String
  pageType         String   @default("custom")
  draftJson        String   @default("{\"sections\":[]}")
  publishedJson    String?
  draftVersion     Int      @default(1)
  publishedVersion Int      @default(0)
  hasUnpublished   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  store            Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, slug])
}

model Category {
  id                String     @id @default(cuid())
  name              String
  slug              String     @unique
  parentId          String?
  commissionPercent Float?
  imageUrl          String?
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  parent            Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[] @relation("CategoryTree")
  products          Product[]
}

model Product {
  id                        String              @id @default(cuid())
  storeId                   String
  categoryId                String?
  title                     String
  slug                      String
  description               String?
  status                    String              @default("draft")
  rejectReason              String?
  priceMinor                Int                 @default(0)
  commissionPercentOverride Float?
  flagsJson                 String              @default("[]")
  reportsCount              Int                 @default(0)
  salesCount                Int                 @default(0)
  ratingAvg                 Float               @default(0)
  ratingCount               Int                 @default(0)
  isFeatured                Boolean             @default(false)
  publishedAt               DateTime?
  sourcePlatform            String?
  sourceShopId              String?
  sourceProductId           String?
  sourceUrl                 String?
  sourceBrand               String?
  sourceStatus              String?
  isFixture                 Boolean             @default(false)
  lastSyncedAt              DateTime?
  overridesJson             String              @default("{}")
  seoTitle                  String?
  seoDescription            String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  chatThreads               ChatThread[]
  collections               CollectionProduct[]
  featuredSlots             FeaturedSlot[]
  importItems               ImportJobItem[]
  orderItems                OrderItem[]
  category                  Category?           @relation(fields: [categoryId], references: [id])
  store                     Store               @relation(fields: [storeId], references: [id])
  images                    ProductImage[]
  variants                  ProductVariant[]
  reviews                   Review[]
  userActivities            UserActivity[]

  @@unique([storeId, slug])
  @@unique([storeId, sourcePlatform, sourceProductId])
  @@index([storeId, status])
  @@index([sourcePlatform, sourceShopId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  alt       String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id                  String         @id @default(cuid())
  productId           String
  name                String         @default("Default")
  optionName          String?
  optionValue         String?
  priceMinor          Int
  compareAtPriceMinor Int?
  stock               Int            @default(0)
  lowStockThreshold   Int            @default(5)
  sku                 String?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  imageUrl            String?
  sourceModelId       String?
  cartItems           CartItem[]
  inventoryLogs       InventoryLog[]
  orderItems          OrderItem[]
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryLog {
  id        String         @id @default(cuid())
  variantId String
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  orderId      String?
  customerName String
  rating       Int
  title        String?
  body         String?
  reply        String?
  status       String   @default("published")
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Collection {
  id          String              @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  store       Store               @relation(fields: [storeId], references: [id])
  products    CollectionProduct[]

  @@unique([storeId, slug])
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String       @id @default(cuid())
  token     String       @unique
  shopperId String?      @unique
  storeId   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  shopper   ShopperUser? @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([shopperId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  qty       Int            @default(1)
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
}

model Order {
  id                  String               @id @default(cuid())
  storeId             String
  orderNumber         String               @unique
  customerName        String
  customerEmail       String
  customerPhone       String?
  cartToken           String?
  shopperId           String?
  status              String               @default("payment_pending")
  disputedFlag        Boolean              @default(false)
  channel             String               @default("storefront")
  currency            String               @default("MYR")
  subtotalMinor       Int                  @default(0)
  discountMinor       Int                  @default(0)
  shippingMinor       Int                  @default(0)
  taxMinor            Int                  @default(0)
  totalMinor          Int                  @default(0)
  couponCode          String?
  shippingAddressJson String               @default("{}")
  customerNote        String?
  paymentProvider     String?
  idemKey             String?              @unique
  paidAt              DateTime?
  fulfilledAt         DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  trackingNumber      String?
  trackingProvider    String?
  riskFlagsJson       String               @default("[]")
  voucherId           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paymentGroupId      String?
  voucher             Voucher?             @relation(fields: [voucherId], references: [id])
  shipment            Shipment?
  disputes            Dispute[]
  paymentGroup        PaymentGroup?        @relation(fields: [paymentGroupId], references: [id])
  shopper             ShopperUser?         @relation(fields: [shopperId], references: [id])
  store               Store                @relation(fields: [storeId], references: [id])
  items               OrderItem[]
  history             OrderStatusHistory[]
  paymentIntents      PaymentIntent[]
  refunds             Refund[]

  @@index([shopperId])
  @@index([paymentGroupId])
}

model Shipment {
  id            String          @id @default(cuid())
  orderId       String          @unique
  storeId       String?
  providerId    String          @default("mock")
  providerRef   String?
  status        String          @default("PENDING_BOOKING") // PENDING_BOOKING|BOOKED|PICKED_UP|IN_TRANSIT|OUT_FOR_DELIVERY|DELIVERED|EXCEPTION|RETURNED
  awbNumber     String?
  courierName   String?
  trackingUrl   String?
  labelUrl      String?
  bookedAt      DateTime?
  pickedUpAt    DateTime?
  etaFrom       DateTime?
  etaTo         DateTime?
  deliveredAt   DateTime?
  lastSyncedAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events        ShipmentEvent[]

  @@index([storeId])
  @@index([status])
}

model ShipmentEvent {
  id            String   @id @default(cuid())
  shipmentId    String
  status        String
  description   String?
  location      String?
  occurredAt    DateTime @default(now())
  proofImageUrl String? // proof-of-delivery photo (courier upload on DELIVERED)
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model StoreFollow {
  id            String      @id @default(cuid())
  shopperUserId String
  storeId       String
  createdAt     DateTime    @default(now())
  shopper       ShopperUser @relation(fields: [shopperUserId], references: [id], onDelete: Cascade)
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([shopperUserId, storeId])
  @@index([storeId])
}

model Notification {
  id            String      @id @default(cuid())
  shopperUserId String
  type          String // order.*, promo, follow, system
  title         String
  body          String?
  dataJson      String      @default("{}")
  readAt        DateTime?
  createdAt     DateTime    @default(now())
  shopper       ShopperUser @relation(fields: [shopperUserId], references: [id], onDelete: Cascade)

  @@index([shopperUserId, readAt])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  presetId    String?
  themeJson   String   @default("{}") // festive decoration theme (colors/copy/ornaments)
  isPublished Boolean  @default(false)
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, startAt, endAt])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  productId         String?
  variantId         String?
  title             String
  variantLabel      String?
  unitPriceMinor    Int
  qty               Int
  lineSubtotalMinor Int
  discountMinor     Int             @default(0)
  shippingMinor     Int             @default(0)
  commissionPercent Float           @default(0)
  commissionMinor   Int             @default(0)
  fixedFeeMinor     Int             @default(0)
  sellerNetMinor    Int             @default(0)
  breakdownJson     String          @default("{}")
  refundedMinor     Int             @default(0)
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  product           Product?        @relation(fields: [productId], references: [id])
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  actor      String   @default("system")
  note       String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentIntent {
  id          String   @id @default(cuid())
  orderId     String
  provider    String
  providerRef String   @unique
  amountMinor Int
  status      String   @default("requires_payment")
  redirectUrl String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentGroup {
  id            String      @id @default(cuid())
  ref           String      @unique
  shopperId     String
  provider      String
  status        String      @default("requires_payment")
  currency      String      @default("MYR")
  subtotalMinor Int         @default(0)
  discountMinor Int         @default(0)
  shippingMinor Int         @default(0)
  totalMinor    Int         @default(0)
  idemKey       String?     @unique
  redirectUrl   String?
  expiresAt     DateTime
  paidAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orders        Order[]
  shopper       ShopperUser @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  @@index([shopperId])
}

model PaymentWebhookLog {
  id             String   @id @default(cuid())
  provider       String
  providerRef    String
  eventType      String
  payloadJson    String
  signatureValid Boolean  @default(false)
  processed      Boolean  @default(false)
  orderId        String?
  createdAt      DateTime @default(now())
}

model Refund {
  id                      String    @id @default(cuid())
  orderId                 String
  amountMinor             Int
  reason                  String?
  status                  String    @default("requested")
  requestedBy             String    @default("seller")
  restock                 Boolean   @default(true)
  commissionReversalMinor Int       @default(0)
  processedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  order                   Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Dispute {
  id         String    @id @default(cuid())
  orderId    String
  reason     String
  status     String    @default("open")
  openedBy   String    @default("shopper")
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Wallet {
  id                      String   @id @default(cuid())
  sellerId                String   @unique
  currency                String   @default("MYR")
  pendingMinor            Int      @default(0)
  availableMinor          Int      @default(0)
  reservedMinor           Int      @default(0)
  lifetimeEarnedMinor     Int      @default(0)
  lifetimeCommissionMinor Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  seller                  Seller   @relation(fields: [sellerId], references: [id])
}

model LedgerAccount {
  code      String   @id
  name      String
  type      String
  walletId  String?
  createdAt DateTime @default(now())
}

model LedgerTransaction {
  id          String       @id @default(cuid())
  txnType     String
  refType     String?
  refId       String?
  description String?
  occurredAt  DateTime     @default(now())
  lines       LedgerLine[]
}

model LedgerLine {
  id          String            @id @default(cuid())
  txnId       String
  accountCode String
  direction   String
  amountMinor Int
  currency    String            @default("MYR")
  walletId    String?
  availableAt DateTime?
  memo        String?
  createdAt   DateTime          @default(now())
  txn         LedgerTransaction @relation(fields: [txnId], references: [id], onDelete: Cascade)
}

model PayoutBatch {
  id          String    @id @default(cuid())
  runType     String    @default("manual")
  status      String    @default("pending")
  currency    String    @default("MYR")
  totalMinor  Int       @default(0)
  payoutCount Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  payouts     Payout[]
}

model Payout {
  id            String       @id @default(cuid())
  batchId       String?
  sellerId      String
  walletId      String
  referenceNo   String       @unique
  amountMinor   Int
  status        String       @default("processing")
  method        String       @default("manual_csv")
  bankAccountId String?
  providerRef   String?
  statementJson String       @default("{}")
  failReason    String?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  batch         PayoutBatch? @relation(fields: [batchId], references: [id])
}

model BankAccount {
  id                  String    @id @default(cuid())
  sellerId            String
  holderName          String
  bankName            String
  accountNumberMasked String
  accountNumberEnc    String
  verified            Boolean   @default(false)
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  seller              Seller    @relation(fields: [sellerId], references: [id])
  payouts             Payout[]
}

model Coupon {
  id               String    @id @default(cuid())
  scope            String    @default("platform")
  storeId          String?
  code             String    @unique
  description      String?
  type             String    @default("percent")
  percent          Float?
  amountMinor      Int?
  minSpendMinor    Int       @default(0)
  maxRedemptions   Int?
  perCustomerLimit Int       @default(1)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean   @default(true)
  timesUsed        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  store            Store?    @relation(fields: [storeId], references: [id])
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  orderId       String
  customerEmail String
  discountMinor Int
  createdAt     DateTime @default(now())
}

model Address {
  id         String       @id @default(cuid())
  ownerToken String
  shopperId  String?
  label      String       @default("Home")
  name       String
  phone      String?
  line1      String
  city       String
  state      String
  postcode   String
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  shopper    ShopperUser? @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  @@index([ownerToken])
  @@index([shopperId])
}

model ShopperWallet {
  id                  String      @id @default(cuid())
  userId              String      @unique
  balanceMinor        Int         @default(0)
  coinBalance         Int         @default(0)
  payLaterLimitMinor  Int         @default(0) // NomoPay Later credit limit (dormant scaffold)
  payLaterUsedMinor   Int         @default(0) // NomoPay Later drawn amount (dormant scaffold)
  lastCheckInAt       DateTime?
  checkInStreak       Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                ShopperUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Voucher {
  id               String        @id @default(cuid())
  code             String        @unique
  title            String
  kind             String        @default("discount")
  discountMinor    Int           @default(0)
  percentOff       Int?
  maxDiscountMinor Int?
  minSpendMinor    Int           @default(0)
  expiryAt         DateTime
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  holders          UserVoucher[]
  // Task 10-b — claimable voucher engine upgrade
  scope            String        @default("PLATFORM") // PLATFORM | STORE
  storeId          String?
  store            Store?        @relation(fields: [storeId], references: [id])
  regionLimit      String? // "peninsular" restricts FS vouchers to West Malaysia
  quota            Int? // total claimable pool (null = unlimited)
  claimedCount     Int           @default(0)
  startsAt         DateTime?
  usedByOrders     Order[]
}

model UserVoucher {
  id        String      @id @default(cuid())
  userId    String
  voucherId String
  status    String      @default("AVAILABLE")
  claimedAt DateTime    @default(now())
  usedAt    DateTime?
  usedOrderId String? // set when the voucher is redeemed on an order
  voucher   Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user      ShopperUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, voucherId])
  @@index([userId, status])
}

model UserActivity {
  id           String      @id @default(cuid())
  userId       String
  productId    String
  activityType String
  createdAt    DateTime    @default(now())
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         ShopperUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, activityType])
  @@index([userId, activityType])
}

model MarketplaceBanner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model FeaturedSlot {
  id        String   @id @default(cuid())
  productId String
  slot      String   @default("home_grid")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StoreIntegration {
  id         String   @id @default(cuid())
  storeId    String
  provider   String
  configJson String   @default("{}")
  isEnabled  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  store      Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, provider])
}

model WebhookEndpoint {
  id         String            @id @default(cuid())
  storeId    String
  url        String
  secret     String
  eventsJson String            @default("[\"order.paid\"]")
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]
  store      Store             @relation(fields: [storeId], references: [id])
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  event         String
  payloadJson   String
  status        String          @default("pending")
  attempts      Int             @default(0)
  responseCode  Int?
  lastAttemptAt DateTime?
  createdAt     DateTime        @default(now())
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(cuid())
  storeId    String
  name       String
  prefix     String
  hash       String
  scopesJson String    @default("[\"read\"]")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  store      Store     @relation(fields: [storeId], references: [id])
}

model Setting {
  key         String   @id
  valueJson   String
  description String?
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  key            String  @id
  description    String?
  isEnabled      Boolean @default(false)
  rolloutPercent Int     @default(100)
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  entityType String
  entityId   String?
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String?
  actorLabel String?
  action     String
  entityType String?
  entityId   String?
  metaJson   String?
  createdAt  DateTime @default(now())
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  event     String
  channel   String
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([event, channel])
}

model NotificationLog {
  id        String   @id @default(cuid())
  event     String
  channel   String
  recipient String
  subject   String?
  status    String   @default("queued")
  error     String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id          String           @id @default(cuid())
  storeId     String?
  sellerEmail String?
  subject     String
  status      String           @default("open")
  priority    String           @default("normal")
  contextType String?
  contextId   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    SupportMessage[]
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  authorType  String
  authorLabel String
  body        String
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String?
  audience  String    @default("all")
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model ExportJob {
  id         String    @id @default(cuid())
  type       String
  status     String    @default("queued")
  paramsJson String    @default("{}")
  rowCount   Int       @default(0)
  fileUrl    String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
}

model MarketplaceConnection {
  id              String      @id @default(cuid())
  storeId         String?
  platform        String
  status          String      @default("pending")
  envConfigured   Boolean     @default(false)
  shopId          String?
  shopName        String?
  shopCipher      String?
  region          String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  scopesJson      String      @default("[]")
  expiresAt       DateTime?
  lastRefreshAt   DateTime?
  lastError       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  jobs            ImportJob[]
  store           Store?      @relation(fields: [storeId], references: [id])

  @@unique([platform, shopId])
  @@index([storeId])
}

model ImportJob {
  id              String                 @id @default(cuid())
  trackingToken   String                 @unique
  storeId         String?
  connectionId    String?
  platform        String
  inputUrl        String
  urlType         String                 @default("unknown")
  sourceShopId    String?
  status          String                 @default("queued")
  phaseDetail     String?
  progressJson    String                 @default("{}")
  errorJson       String                 @default("{}")
  summaryJson     String                 @default("{}")
  isFixture       Boolean                @default(false)
  storeCreated    Boolean                @default(false)
  claimedById     String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sourceProductId String?
  connection      MarketplaceConnection? @relation(fields: [connectionId], references: [id])
  store           Store?                 @relation(fields: [storeId], references: [id])
  items           ImportJobItem[]

  @@index([status])
  @@index([platform, createdAt])
}

model ImportJobItem {
  id              String    @id @default(cuid())
  jobId           String
  productId       String?
  sourcePlatform  String
  sourceShopId    String?
  sourceProductId String
  title           String?
  status          String    @default("pending")
  error           String?
  warningsJson    String    @default("[]")
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  product         Product?  @relation(fields: [productId], references: [id])
  job             ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourcePlatform, sourceProductId])
  @@index([jobId, status])
}

model StoreClaim {
  id                     String    @id @default(cuid())
  storeId                String
  jobId                  String?
  tokenHash              String    @unique
  status                 String    @default("active")
  verificationMethod     String    @default("pending")
  verificationResultJson String    @default("{}")
  expiresAt              DateTime
  usedById               String?
  usedAt                 DateTime?
  createdAt              DateTime  @default(now())
  store                  Store     @relation(fields: [storeId], references: [id])

  @@index([storeId, status])
}

model SeoMeta {
  id                 String   @id @default(cuid())
  entityType         String
  entityId           String
  seoTitle           String?
  seoDescription     String?
  ogImage            String?
  canonicalUrl       String?
  noindex            Boolean  @default(false)
  structuredDataJson String   @default("{}")
  lockedFieldsJson   String   @default("[]")
  warningsJson       String   @default("[]")
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([entityType])
}
