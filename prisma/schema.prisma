generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Named SUPABASE_DATABASE_URL (not DATABASE_URL) deliberately: this sandbox's
  // harness injects a stale DATABASE_URL=file:... into every shell session, and
  // exported env vars override .env files for Prisma/Next. A distinct var name
  // makes the Supabase connection immune to that override.
  url = env("SUPABASE_DATABASE_URL")
}

model Plan {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  monthlyFeeMinor   Int      @default(0)
  commissionPercent Float?
  productLimit      Int?
  mediaLimitMb      Int?
  staffLimit        Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CommissionSetting {
  id                      Int     @id @default(autoincrement())
  defaultPercent          Float   @default(8.0)
  appliesToShipping       Boolean @default(false)
  basePriceRule           String  @default("paid_price")
  fixedFeeMinor           Int     @default(0)
  minCommissionMinor      Int     @default(0)
  payoutHoldDays          Int     @default(7)
  holdReleaseRule         String  @default("days_after_paid")
  graceDaysAfterDelivered Int     @default(2)
}

// Snapshot of a commission report export (FIN-08). The CSV is regenerated
// from snapshotJson at download time so the historical file never changes.
model CommissionExport {
  id             String   @id @default(cuid())
  periodFrom     DateTime
  periodTo       DateTime
  totalMinor     Int
  orderCount     Int
  lineCount      Int
  format         String   @default("csv")
  snapshotJson   String
  createdByEmail String
  createdAt      DateTime @default(now())
}

model CommissionOverride {
  id            String    @id @default(cuid())
  scope         String
  categoryId    String?
  sellerId      String?
  productId     String?
  percent       Float?
  fixedFeeMinor Int?
  holdDays      Int?
  validFrom     DateTime?
  validTo       DateTime?
  isActive      Boolean   @default(true)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FeeHoliday {
  id        String   @id @default(cuid())
  name      String
  scope     String   @default("all")
  scopeIds  String?
  percent   Float    @default(0)
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    @default("ops")
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  mfa          AdminMfaEnrollment?
}

/// Phase 1 (C4): TOTP MFA enrollment for administrators.
/// `secretEnc` = AES-256-GCM (iv:tag:ciphertext, base64 segments) encrypted
/// with MFA_ENCRYPTION_KEY. `recoveryHashes` = JSON array of sha256(code)
/// hex digests - one-time-use recovery codes, never stored in plaintext.
/// `confirmedAt` null = enrollment started but not yet verified by a valid
/// TOTP code; login enforcement only applies once confirmed.
/// Phase 2.1: `lastUsedTotpCounter` = the TOTP time-step counter of the most
/// recently ACCEPTED code — CAS-guarded monotonic update rejects any code
/// from an already-used time step (replay protection, RFC 6238 §5.2). Null
/// until the first accepted code.
model AdminMfaEnrollment {
  id                  String    @id @default(cuid())
  adminId             String    @unique
  secretEnc           String
  recoveryHashes      String
  confirmedAt         DateTime?
  lastUsedTotpCounter Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  admin               AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Seller {
  id                        String        @id @default(cuid())
  email                     String        @unique
  passwordHash              String
  /// PHASE 2.3 (C2.7): timestamp of the seller's successful EMAIL OWNERSHIP
  /// verification (purpose "seller-email" EmailOtpChallenge consumed → this
  /// column is set in the SAME transaction as the consume). Null = NOT
  /// verified — every display must treat null as unverified (KYC honesty
  /// rule: never claim verification that did not occur). Migration
  /// 20261107000000 (authored, not applied to the dev DB).
  emailVerifiedAt           DateTime?
  fullName                  String
  displayName               String
  countryCode               String        @default("MY")
  phone                     String?
  status                    String        @default("onboarding")
  riskTier                  String        @default("low")
  commissionOverridePercent Float?
  holdDaysOverride          Int?
  kycStatus                 String        @default("pending")
  planCode                  String        @default("free")
  marketplaceOptIn          Boolean       @default(true)
  rejectReason              String?
  submittedAt               DateTime?
  approvedAt                DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  bankAccounts              BankAccount[]
  kycDocuments              KycDocument[]
  sellerNotes               SellerNote[]
  store                     Store?
  wallet                    Wallet?
}

model KycDocument {
  id           String    @id @default(cuid())
  sellerId     String
  docType      String
  fileName     String
  status       String    @default("pending")
  rejectReason String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  seller       Seller    @relation(fields: [sellerId], references: [id])
}

model SellerNote {
  id        String   @id @default(cuid())
  sellerId  String
  author    String
  body      String
  createdAt DateTime @default(now())
  seller    Seller   @relation(fields: [sellerId], references: [id])
}

model Session {
  token     String   @id @default(cuid())
  userType  String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// FINAL CLOSURE (guest-order OTP + shopper email verification) — ONE challenge
// table serves both purposes (no column was added to ShopperUser/Order on
// purpose: a missing column would break every existing query pre-migration,
// while a missing TABLE is tolerated fail-closed via the P2021 guard, exactly
// like AdminMfaEnrollment):
//   purpose "guest-order"   → subjectId = Order.id. Successful verify DELETES
//     the row (CAS) — the issued order-access grant is the artifact. The
//     knowledge pair (email + NM- order number) can now only REQUEST this
//     challenge; it no longer authorizes any order data.
//   purpose "shopper-email" → subjectId = ShopperUser.id. Row PERSISTS with
//     verifiedAt set — the durable proof of email ownership that gates
//     guest-order claiming in claimGuestStateForShopper().
//   purpose "seller-email" (PHASE 2.3 / C2.7) → subjectId = Seller.id. Row
//     PERSISTS with verifiedAt set exactly like shopper-email, AND the
//     winner's route transaction mirrors the proof onto Seller.emailVerifiedAt
//     (migration 20261107000000) inside the same $transaction as the CAS
//     consume — the challenge row and the seller column can never diverge.
// Codes are stored ONLY as HMAC-SHA256(EMAIL_OTP_SECRET, "otp:v1:" + purpose +
// ":" + subjectId + ":" + utcDayBucket + ":" + code) — never plaintext, never
// logged. `attempts` survives re-issuance while a row is unexpired (repeated
// issuance cannot reset brute-force accounting); it resets only after expiry.
// No FK on purpose/subjectId: the subject is polymorphic by design.
model EmailOtpChallenge {
  id         String    @id @default(cuid())
  purpose    String
  subjectId  String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([purpose, subjectId])
}

model ShopperUser {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  fullName        String
  username        String?        @unique
  avatarUrl       String?
  membershipLevel String         @default("SILVER")
  followingCount  Int            @default(0)
  followerCount   Int            @default(0)
  phone           String?
  status          String         @default("active")
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  addresses       Address[]
  carts           Cart?
  chatThreads     ChatThread[]
  orders          Order[]
  paymentGroups   PaymentGroup[]
  wallet          ShopperWallet?
  activities      UserActivity[]
  vouchers        UserVoucher[]
  follows         StoreFollow[]
  notifications   Notification[]
  affiliateProfile AffiliateProfile?
  reviews      Review[]
}

model ChatThread {
  id            String        @id @default(cuid())
  shopperId     String
  storeId       String
  orderNumber   String?
  orderId       String?
  contextType   String?
  productId     String?
  subject       String?
  shopperUnread Int           @default(0)
  sellerUnread  Int           @default(0)
  createdAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]
  product       Product?      @relation(fields: [productId], references: [id])
  store         Store         @relation(fields: [storeId], references: [id])
  shopper       ShopperUser   @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  @@unique([shopperId, storeId])
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  senderType String
  senderName String
  body       String
  readAt     DateTime?
  createdAt  DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, readAt])
}

model Store {
  id               String                  @id @default(cuid())
  sellerId         String?                 @unique
  name             String
  slug             String                  @unique
  tagline          String?
  logoUrl          String?
  bannerUrl        String?
  description      String?
  status           String                  @default("draft")
  lifecycleSource  String                  @default("native")
  currency         String                  @default("MYR")
  timezone         String                  @default("Asia/Kuala_Lumpur")
  themeJson        String                  @default("{}")
  supportEmail     String?
  supportPhone     String?
  whatsapp         String?
  socialJson       String                  @default("{}")
  templateKey      String                  @default("aurora")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  apiKeys          ApiKey[]
  chatThreads      ChatThread[]
  pages            CmsPage[]
  collections      Collection[]
  coupons          Coupon[]
  importJobs       ImportJob[]
  connections      MarketplaceConnection[]
  orders           Order[]
  products         Product[]
  followers        StoreFollow[]
  vouchers         Voucher[]
  fsPriceAdjustMinor Int                    @default(0) // seller-funded free-shipping cost recovery (v1)
  // AFFILIATE — seller programme opt-in + default per-product rate (bps).
  // Per-product override lives on Product.affiliateRateBps; the effective
  // rate = product override ?? store default, clamped to the platform max
  // (affiliate.max_rate_bps Setting) at every read.
  affiliateOptIn          Boolean         @default(false)
  affiliateDefaultRateBps Int             @default(0)
  seller           Seller?                 @relation(fields: [sellerId], references: [id])
  claims           StoreClaim[]
  domains          StoreDomain[]
  integrations     StoreIntegration[]
  webhookEndpoints WebhookEndpoint[]
  cartSettings     CartSettings?
  cardStyle        ProductCardStyle?
}

model StoreDomain {
  id            String    @id @default(cuid())
  storeId       String
  domain        String    @unique
  mode          String    @default("cname")
  status        String    @default("pending")
  sslStatus     String    @default("pending")
  isPrimary     Boolean   @default(false)
  lastCheckedAt DateTime?
  errorReason   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  store         Store     @relation(fields: [storeId], references: [id])
}

model CmsPage {
  id               String   @id @default(cuid())
  storeId          String
  slug             String
  title            String
  pageType         String   @default("custom")
  draftJson        String   @default("{\"sections\":[]}")
  publishedJson    String?
  draftVersion     Int      @default(1)
  publishedVersion Int      @default(0)
  hasUnpublished   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  store            Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, slug])
}

model Category {
  id                String     @id @default(cuid())
  name              String
  slug              String     @unique
  parentId          String?
  commissionPercent Float?
  imageUrl          String?
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  parent            Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[] @relation("CategoryTree")
  products          Product[]
}

model Product {
  id                        String              @id @default(cuid())
  storeId                   String
  categoryId                String?
  title                     String
  slug                      String
  description               String?
  status                    String              @default("draft")
  rejectReason              String?
  priceMinor                Int                 @default(0)
  commissionPercentOverride Float?
  flagsJson                 String              @default("[]")
  reportsCount              Int                 @default(0)
  salesCount                Int                 @default(0)
  ratingAvg                 Float               @default(0)
  ratingCount               Int                 @default(0)
  isFeatured                Boolean             @default(false)
  publishedAt               DateTime?
  sourcePlatform            String?
  sourceShopId              String?
  sourceProductId           String?
  sourceUrl                 String?
  sourceBrand               String?
  sourceStatus              String?
  isFixture                 Boolean             @default(false)
  lastSyncedAt              DateTime?
  overridesJson             String              @default("{}")
  // AFFILIATE — per-product programme enrollment + rate override (bps).
  // affiliateRateBps NULL ⇒ inherit Store.affiliateDefaultRateBps.
  affiliateEnabled          Boolean             @default(false)
  affiliateRateBps          Int?
  seoTitle                  String?
  seoDescription            String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  chatThreads               ChatThread[]
  collections               CollectionProduct[]
  featuredSlots             FeaturedSlot[]
  importItems               ImportJobItem[]
  orderItems                OrderItem[]
  affiliateCollectionItems  AffiliateCollectionItem[]
  category                  Category?           @relation(fields: [categoryId], references: [id])
  store                     Store               @relation(fields: [storeId], references: [id])
  images                    ProductImage[]
  variants                  ProductVariant[]
  reviews                   Review[]
  userActivities            UserActivity[]

  @@unique([storeId, slug])
  @@unique([storeId, sourcePlatform, sourceProductId])
  @@index([storeId, status])
  @@index([sourcePlatform, sourceShopId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  alt       String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id                  String         @id @default(cuid())
  productId           String
  name                String         @default("Default")
  optionName          String?
  optionValue         String?
  priceMinor          Int
  compareAtPriceMinor Int?
  stock               Int            @default(0)
  // Minimum order quantity set by the seller for THIS item (variant-level).
  // Enforced in the cart (add/patch), the quote and checkout-create, so a
  // launch rush can never slip a below-MOQ line through.
  moq                 Int            @default(1)
  lowStockThreshold   Int            @default(5)
  sku                 String?
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  imageUrl            String?
  sourceModelId       String?
  cartItems           CartItem[]
  inventoryLogs       InventoryLog[]
  orderItems          OrderItem[]
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Seller Insights: relation + current-cart snapshot queries.
  @@index([productId])
}

model InventoryLog {
  id        String         @id @default(cuid())
  variantId String
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // PHASE 2 / B: FK index — every cascade variant deletion otherwise scans
  // this append-heavy table; consistent with the CartItem/OrderItem FK pattern.
  @@index([variantId])
}

/// Phase 1 (SEC-03 / B1): verified-purchase reviews.
/// shopperId = verified buyer (null = legacy rows); orderId = eligible
/// completed/delivered order backing the review; status pending until an
/// admin publishes; @@unique enforces one review per buyer per product.
model Review {
  id           String       @id @default(cuid())
  productId    String
  orderId      String?
  shopperId    String?
  customerName String
  rating       Int
  title        String?
  body         String?
  reply        String?
  status       String       @default("pending")
  createdAt    DateTime     @default(now())
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shopper      ShopperUser? @relation(fields: [shopperId], references: [id], onDelete: SetNull)

  @@unique([productId, shopperId])
}

model Collection {
  id          String              @id @default(cuid())
  storeId     String
  name        String
  slug        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  store       Store               @relation(fields: [storeId], references: [id])
  products    CollectionProduct[]

  @@unique([storeId, slug])
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String       @id @default(cuid())
  token     String       @unique
  shopperId String?      @unique
  storeId   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  shopper   ShopperUser? @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([shopperId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  qty       Int            @default(1)
  // Buyer-controlled checkout selection: uncheck an item (or a whole seller)
  // to keep it in the cart while checking out the rest. Checked-out lines are
  // removed by the payment webhook; unselected lines survive for later.
  selected  Boolean        @default(true)
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Seller Insights: relation + current-cart snapshot queries.
  @@index([cartId])
  @@index([variantId])
}

model Order {
  id                  String               @id @default(cuid())
  storeId             String
  orderNumber         String               @unique
  customerName        String
  customerEmail       String
  customerPhone       String?
  cartToken           String?
  shopperId           String?
  status              String               @default("payment_pending")
  disputedFlag        Boolean              @default(false)
  channel             String               @default("storefront")
  currency            String               @default("MYR")
  subtotalMinor       Int                  @default(0)
  discountMinor       Int                  @default(0)
  shippingMinor       Int                  @default(0)
  taxMinor            Int                  @default(0)
  totalMinor          Int                  @default(0)
  couponCode          String?
  shippingAddressJson String               @default("{}")
  customerNote        String?
  paymentProvider     String?
  idemKey             String?              @unique
  paidAt              DateTime?
  fulfilledAt         DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  trackingNumber      String?
  trackingProvider    String?
  riskFlagsJson       String               @default("[]")
  voucherId           String?
  // Geographic sales snapshot (Seller Insights): destination country recorded at
  // checkout time. "" = not recorded (pre-feature historical rows pending backfill).
  // source: "checkout" = written by checkout-create; "backfill" = derived from the
  // frozen shippingAddressJson (5-digit postcode + known MY state rule); code "ZZ" = unspecified.
  shippingCountryCode   String             @default("")
  shippingCountrySource String             @default("")
  // Marketing attribution snapshot (Marketing Intelligence): frozen at checkout
  // creation from the shopper's validated attribution cookie (last-touch UTM /
  // campaign-link token). Null = unattributed (pre-feature history or untagged
  // visit) — NEVER backfilled or guessed. Plain strings (no FK) by design.
  attrCampaignId        String?
  attrSource            String?
  attrMedium            String?
  attrCampaign          String?
  attrTerm              String?
  attrContent           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paymentGroupId      String?
  voucher             Voucher?             @relation(fields: [voucherId], references: [id])
  shipment            Shipment?
  disputes            Dispute[]
  paymentGroup        PaymentGroup?        @relation(fields: [paymentGroupId], references: [id])
  shopper             ShopperUser?         @relation(fields: [shopperId], references: [id])
  store               Store                @relation(fields: [storeId], references: [id])
  items               OrderItem[]
  history             OrderStatusHistory[]
  paymentIntents      PaymentIntent[]
  refunds             Refund[]
  affiliateCommissions AffiliateCommission[]

  @@index([shopperId])
  @@index([paymentGroupId])
  // Seller Insights aggregation indexes (additive): every dashboard/report query
  // filters by store + payment date.
  @@index([storeId, paidAt])
  @@index([paidAt])
  // Marketing Intelligence: campaign report filters orders by attributed campaign.
  @@index([storeId, attrCampaignId])
  // PHASE 2 / B: seller order-listing views filter by store + status group
  // (unpaid / to_fulfill / shipped / done / refunds) — the primary seller
  // workflow query (store/orders route: WHERE storeId = ? AND status IN (...)).
  @@index([storeId, status])
  // PHASE 2 / B: order-maintenance auto-complete sweep (cron, 30 s cadence):
  // WHERE status = 'delivered' AND deliveredAt < cutoff ORDER BY deliveredAt ASC.
  @@index([status, deliveredAt])
  reviews      Review[]
}

model Shipment {
  id            String          @id @default(cuid())
  orderId       String          @unique
  storeId       String?
  providerId    String          @default("mock")
  providerRef   String?
  status        String          @default("PENDING_BOOKING") // PENDING_BOOKING|BOOKED|PICKED_UP|IN_TRANSIT|OUT_FOR_DELIVERY|DELIVERED|EXCEPTION|RETURNED
  awbNumber     String?
  courierName   String?
  trackingUrl   String?
  labelUrl      String?
  bookedAt      DateTime?
  pickedUpAt    DateTime?
  etaFrom       DateTime?
  etaTo         DateTime?
  deliveredAt   DateTime?
  lastSyncedAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events        ShipmentEvent[]

  @@index([storeId])
  @@index([status])
}

model ShipmentEvent {
  id            String   @id @default(cuid())
  shipmentId    String
  status        String
  description   String?
  location      String?
  occurredAt    DateTime @default(now())
  proofImageUrl String? // proof-of-delivery photo (courier upload on DELIVERED)
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model StoreFollow {
  id            String      @id @default(cuid())
  shopperUserId String
  storeId       String
  createdAt     DateTime    @default(now())
  shopper       ShopperUser @relation(fields: [shopperUserId], references: [id], onDelete: Cascade)
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([shopperUserId, storeId])
  @@index([storeId])
}

model Notification {
  id            String      @id @default(cuid())
  shopperUserId String
  type          String // order.*, promo, follow, system
  title         String
  body          String?
  dataJson      String      @default("{}")
  readAt        DateTime?
  createdAt     DateTime    @default(now())
  shopper       ShopperUser @relation(fields: [shopperUserId], references: [id], onDelete: Cascade)

  @@index([shopperUserId, readAt])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  presetId    String?
  themeJson   String   @default("{}") // festive decoration theme (colors/copy/ornaments)
  isPublished Boolean  @default(false)
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ---- Work order 14: homepage merchandising (banners/placements). The
  // campaign table stays the SINGLE source of truth — these fields extend it;
  // no second campaign system. Pricing/discount rules are deliberately NOT
  // here: a homepage banner never alters product prices.
  // Short description (hero subtext / showcase cards). ≤280 chars enforced at
  // the API layer.
  description      String?
  // Homepage placement: hero | hero_secondary | promo_tile | showcase | inline
  // (validated at the API layer; default showcase keeps legacy rows visible).
  placement        String    @default("showcase")
  // Within-placement ordering: priority DESC, then displayOrder ASC.
  priority         Int       @default(0)
  displayOrder     Int       @default(0)
  // CTA copy + destination token (search / category:<slug> / store:<slug> /
