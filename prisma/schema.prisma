  // ---------------------------------------------------------------------
  // AFFILIATE (Hub & one-level sponsor referral). Snapshot frozen at
  // checkout creation — EXACTLY the commission contract above: never
  // recomputed, never backfilled. Written server-side from validated
  // attribution touches (lib/affiliate-attribution.ts); client-supplied
  // affiliate ids are never trusted. All nullable/zero when the item has no
  // affiliate attribution (unattributed, programme disabled, product not
  // enrolled, or self-purchase).
  affiliateDirectId   String? // direct affiliate (profile id) — 90% beneficiary
  affiliateSponsorId  String? // their one-level sponsor (profile id) — 10% candidate
  affiliateLinkId     String? // promotional link that earned the attribution
  affiliateRateBps    Int?    // snapshotted seller affiliate rate (basis points)
  affiliatePoolMinor  Int     @default(0) // seller-funded pool carved from sellerNet
  // POST-IMPLEMENTATION AUDIT (P3): freeze the sponsor-override policy AT
  // CHECKOUT so later settings changes never retroactively alter an in-flight
  // order's compensation arrangement. NULL only on legacy rows created before
  // this column existed (posting then falls back to the then-current setting,
  // preserving the historical behaviour those orders were created under).
  affiliateSponsorEnabled Boolean?
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  product           Product?        @relation(fields: [productId], references: [id])
