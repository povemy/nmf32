// ============================================================================
// SHOPMESH v1 — Prisma schema (SQLite adaptation of PART2 PostgreSQL DDL)
// Conventions: money = Int minor units (cents); percent = Float;
// JSONB -> String columns holding JSON (parse via src/lib/json.ts);
// enums -> String + app-level validation; time = DateTime UTC.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- A: CONFIG

model Plan {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  monthlyFeeMinor   Int      @default(0)
  commissionPercent Float?
  productLimit      Int?
  mediaLimitMb      Int?
  staffLimit        Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CommissionSetting {
  id                        Int    @id @default(1)
  defaultPercent            Float  @default(8.0)
  appliesToShipping         Boolean @default(false)
  basePriceRule             String @default("paid_price") // paid_price | list_price
  fixedFeeMinor             Int    @default(0)
  minCommissionMinor        Int    @default(0)
  payoutHoldDays            Int    @default(7)
  holdReleaseRule           String @default("days_after_paid") // days_after_paid | days_after_delivered
  graceDaysAfterDelivered   Int    @default(2)
}

model CommissionOverride {
  id            String    @id @default(cuid())
  scope         String // category | seller | product
  categoryId    String?
  sellerId      String?
  productId     String?
  percent       Float?
  fixedFeeMinor Int?
  holdDays      Int?
  validFrom     DateTime?
  validTo       DateTime?
  isActive      Boolean   @default(true)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FeeHoliday {
  id        String   @id @default(cuid())
  name      String
  scope     String   @default("all") // all | sellers | categories
  scopeIds  String? // JSON array of ids
  percent   Float    @default(0)
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- B: IDENTITY

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    @default("ops") // superadmin | ops | finance | moderator | support | readonly
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Seller {
  id                        String    @id @default(cuid())
  email                     String    @unique
  passwordHash              String
  fullName                  String
  displayName               String
  countryCode               String    @default("MY")
  phone                     String?
  status                    String    @default("onboarding") // onboarding | pending_review | active | suspended | terminated | rejected
  riskTier                  String    @default("low") // low | medium | high
  commissionOverridePercent Float?
  holdDaysOverride          Int?
  kycStatus                 String    @default("pending") // pending | approved | rejected
  planCode                  String    @default("free")
  marketplaceOptIn          Boolean   @default(true)
  rejectReason              String?
  submittedAt               DateTime?
  approvedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  store            Store?
  wallet           Wallet?
  kycDocuments     KycDocument[]
  bankAccounts     BankAccount[]
  sellerNotes      SellerNote[]
}

model KycDocument {
  id          String    @id @default(cuid())
  sellerId    String
  seller      Seller    @relation(fields: [sellerId], references: [id])
  docType     String // ic_front | ic_selfie | business_reg | bank_statement
  fileName    String
  status      String    @default("pending") // pending | approved | rejected
  rejectReason String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model SellerNote {
  id        String   @id @default(cuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id])
  author    String
  body      String
  createdAt DateTime @default(now())
}

model Session {
  token     String   @id @default(cuid())
  userType  String // admin | seller | shopper
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- B2: SHOPPERS

model ShopperUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  fullName        String
  username        String?   @unique // public handle shown on the Me hub (@handle)
  avatarUrl       String?
  membershipLevel String    @default("SILVER") // SILVER | GOLD | PLATINUM (auto-upgraded on spend thresholds)
  followingCount  Int       @default(0)
  followerCount   Int       @default(0)
  phone           String?
  status          String    @default("active") // active | suspended
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  chatThreads     ChatThread[]
  wallet          ShopperWallet?
  vouchers        UserVoucher[]
  activities      UserActivity[]
  addresses       Address[]
  orders          Order[]
}

model ChatThread {
  id            String   @id @default(cuid())
  shopperId     String
  shopper       ShopperUser @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  orderNumber   String?  // order context when opened from an order
  orderId       String?  // resolved order id (deep link target for the context bubble)
  contextType   String?  // what the conversation is about: "order" | "product" | null
  productId     String?  // product context when opened from a product page
  product       Product? @relation(fields: [productId], references: [id])
  subject       String?
  shopperUnread Int      @default(0) // unread seller messages for the shopper
  sellerUnread  Int      @default(0) // unread shopper messages for the seller
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())
  messages      ChatMessage[]

  @@unique([shopperId, storeId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderType String // shopper | seller
  senderName String
  body       String
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------- C: STORES

model Store {
  id              String    @id @default(cuid())
  sellerId        String?   @unique // nullable: generated-but-unclaimed stores have no owner yet
  seller          Seller?   @relation(fields: [sellerId], references: [id])
  name            String
  slug            String    @unique
  tagline         String?
  logoUrl         String?
  bannerUrl       String?
  description     String?
  status          String    @default("draft") // draft | live | maintenance | generating | pending_verification | pending_claim | claimed | suspended | archived
  lifecycleSource String    @default("native") // native | import
  currency        String    @default("MYR")
  timezone        String    @default("Asia/Kuala_Lumpur")
  themeJson       String    @default("{}")
  supportEmail    String?
  supportPhone    String?
  whatsapp        String?
  socialJson      String    @default("{}")
  templateKey     String    @default("aurora")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  pages           CmsPage[]
  products        Product[]
  orders          Order[]
  domains         StoreDomain[]
  collections     Collection[]
  coupons         Coupon[]
  integrations    StoreIntegration[]
  webhookEndpoints WebhookEndpoint[]
  apiKeys         ApiKey[]
  claims          StoreClaim[]
  connections     MarketplaceConnection[]
  importJobs      ImportJob[]
  chatThreads     ChatThread[]
}

model StoreDomain {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  domain        String    @unique
  mode          String    @default("cname") // cname | ns
  status        String    @default("pending") // pending | verifying | verified | active | failed
  sslStatus     String    @default("pending") // pending | issued | failed
  isPrimary     Boolean   @default(false)
  lastCheckedAt DateTime?
  errorReason   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CmsPage {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  slug            String
  title           String
  pageType        String   @default("custom") // home | about | contact | policy | custom
  draftJson       String   @default("{\"sections\":[]}")
  publishedJson   String?
  draftVersion    Int      @default(1)
  publishedVersion Int     @default(0)
  hasUnpublished   Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([storeId, slug])
}

// ---------------------------------------------------------------- D: CATALOG

model Category {
  id                String     @id @default(cuid())
  name              String
  slug              String     @unique
  parentId          String?
  parent            Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[] @relation("CategoryTree")
  commissionPercent Float?
  imageUrl          String?
  sortOrder         Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  products          Product[]
}

model Product {
  id                        String    @id @default(cuid())
  storeId                   String
  store                     Store     @relation(fields: [storeId], references: [id])
  categoryId                String?
  category                  Category? @relation(fields: [categoryId], references: [id])
  title                     String
  slug                      String
  description               String?
  status                    String    @default("draft") // draft | pending_review | active | rejected | banned | archived
  rejectReason              String?
  priceMinor                Int       @default(0)
  commissionPercentOverride Float?
  flagsJson                 String    @default("[]") // moderation flag reasons
  reportsCount              Int       @default(0)
  salesCount                Int       @default(0)
  ratingAvg                 Float     @default(0)
  ratingCount               Int       @default(0)
  isFeatured                Boolean   @default(false)
  publishedAt               DateTime?
  // --- marketplace import source fields (Phase 4) ---
  sourcePlatform            String? // shopee | tiktok | fixture
  sourceShopId              String?
  sourceProductId           String?
  sourceUrl                 String?
  sourceBrand               String?
  sourceStatus              String? // availability at source
  isFixture                 Boolean  @default(false) // imported from the demo fixture connector
  lastSyncedAt              DateTime?
  overridesJson             String    @default("{}") // seller-owned fields: {title:true,...} survive re-import
  seoTitle                  String?
  seoDescription            String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  images                    ProductImage[]
  variants                  ProductVariant[]
  reviews                   Review[]
  orderItems                OrderItem[]
  collections               CollectionProduct[]
  featuredSlots             FeaturedSlot[]
  importItems               ImportJobItem[]
  chatThreads               ChatThread[]
  userActivities            UserActivity[]

  @@unique([storeId, slug])
  @@unique([storeId, sourcePlatform, sourceProductId])
  @@index([storeId, status])
  @@index([sourcePlatform, sourceShopId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String? // accessibility + SEO alt text (import)
  sortOrder Int     @default(0)
}

model ProductVariant {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String   @default("Default")
  optionName         String?
  optionValue        String?
  sourceModelId      String?  // marketplace variant identifier (import sync)
  imageUrl           String?  // variant-specific image (import)
  priceMinor         Int
  compareAtPriceMinor Int?
  stock              Int      @default(0)
  lowStockThreshold  Int      @default(5)
  sku                String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryLogs      InventoryLog[]
}

model InventoryLog {
  id        String        @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime      @default(now())
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String?
  customerName String
  rating    Int
  title     String?
  body      String?
  reply     String?
  status    String   @default("published") // published | hidden
  createdAt DateTime @default(now())
}

model Collection {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    CollectionProduct[]

  @@unique([storeId, slug])
}

model CollectionProduct {
  id           String    @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- E: CART / ORDERS

model Cart {
  id        String   @id @default(cuid())
  token     String   @unique
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  qty       Int            @default(1)
  createdAt DateTime       @default(now())
}

model Order {
  id                  String    @id @default(cuid())
  storeId             String
  store               Store     @relation(fields: [storeId], references: [id])
  orderNumber         String    @unique
  customerName        String
  customerEmail       String
  customerPhone       String?
  cartToken           String?   // guest cart that produced this order — cleared on payment success
  shopperId           String?   // owning shopper account when known (login/checkout session); null for pure guests
  shopper             ShopperUser? @relation(fields: [shopperId], references: [id], onDelete: SetNull)
  status              String    @default("payment_pending") // payment_pending | paid | processing | shipped | delivered | completed | cancelled | refunding | partially_refunded | refunded | closed
  disputedFlag        Boolean   @default(false)
  channel             String    @default("storefront") // storefront | market
  currency            String    @default("MYR")
  subtotalMinor       Int       @default(0)
  discountMinor       Int       @default(0)
  shippingMinor       Int       @default(0)
  taxMinor            Int       @default(0)
  totalMinor          Int       @default(0)
  couponCode          String?
  shippingAddressJson String    @default("{}")
  customerNote        String?
  paymentProvider     String?
  idemKey             String?   @unique
  paidAt              DateTime?
  fulfilledAt         DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  trackingNumber      String?
  trackingProvider    String?
  riskFlagsJson       String    @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  items               OrderItem[]
  history             OrderStatusHistory[]
  paymentIntents      PaymentIntent[]
  refunds             Refund[]
  disputes            Dispute[]

  @@index([shopperId])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  order                Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String?
  product              Product? @relation(fields: [productId], references: [id])
  variantId            String?
  variant              ProductVariant? @relation(fields: [variantId], references: [id])
  title                String
  variantLabel         String?
  unitPriceMinor       Int
  qty                  Int
  lineSubtotalMinor    Int
  discountMinor        Int     @default(0)
  shippingMinor        Int     @default(0)
  commissionPercent    Float   @default(0)
  commissionMinor      Int     @default(0)
  fixedFeeMinor        Int     @default(0)
  sellerNetMinor       Int     @default(0)
  breakdownJson        String  @default("{}")
  refundedMinor        Int     @default(0)
}

model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actor      String   @default("system") // system | seller | admin | shopper
  note       String?
  createdAt  DateTime @default(now())
}

model PaymentIntent {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider     String // fpx_toyyibpay | fpx_curlec | tng | grabpay | card_stripe
  providerRef  String    @unique
  amountMinor  Int
  status       String    @default("requires_payment") // requires_payment | processing | succeeded | failed | refunded
  redirectUrl  String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PaymentWebhookLog {
  id             String   @id @default(cuid())
  provider       String
  providerRef    String
  eventType      String
  payloadJson    String
  signatureValid Boolean  @default(false)
  processed      Boolean  @default(false)
  orderId        String?
  createdAt      DateTime @default(now())
}

model Refund {
  id                      String    @id @default(cuid())
  orderId                 String
  order                   Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountMinor             Int
  reason                  String?
  status                  String    @default("requested") // requested | approved | processed | rejected
  requestedBy             String    @default("seller") // seller | admin | shopper
  restock                 Boolean   @default(true)
  commissionReversalMinor Int       @default(0)
  processedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Dispute {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason     String
  status     String    @default("open") // open | under_review | resolved | rejected
  openedBy   String    @default("shopper")
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ---------------------------------------------------------------- F: MONEY

model Wallet {
  id                    String  @id @default(cuid())
  sellerId              String  @unique
  seller                Seller  @relation(fields: [sellerId], references: [id])
  currency              String  @default("MYR")
  pendingMinor          Int     @default(0)
  availableMinor        Int     @default(0)
  reservedMinor         Int     @default(0)
  lifetimeEarnedMinor   Int     @default(0)
  lifetimeCommissionMinor Int   @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model LedgerAccount {
  code        String  @id
  name        String
  type        String // asset | liability | revenue | expense
  walletId    String? // for SELLER:*:PAYABLE accounts
  createdAt   DateTime @default(now())
}

model LedgerTransaction {
  id          String   @id @default(cuid())
  txnType     String // order_paid | gateway_settlement | payout_initiated | payout_confirmed | payout_failed | refund | admin_adjustment
  refType     String?
  refId       String?
  description String?
  occurredAt  DateTime @default(now())
  lines       LedgerLine[]
}

model LedgerLine {
  id             String            @id @default(cuid())
  txnId          String
  txn            LedgerTransaction @relation(fields: [txnId], references: [id], onDelete: Cascade)
  accountCode    String
  direction      String // debit | credit
  amountMinor    Int
  currency       String            @default("MYR")
  walletId       String?
  availableAt    DateTime?
  memo           String?
  createdAt      DateTime          @default(now())
}

model PayoutBatch {
  id          String    @id @default(cuid())
  runType     String    @default("manual") // manual | scheduled
  status      String    @default("pending") // pending | running | completed | failed
  currency    String    @default("MYR")
  totalMinor  Int       @default(0)
  payoutCount Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  payouts     Payout[]
}

model Payout {
  id             String      @id @default(cuid())
  batchId        String?
  batch          PayoutBatch? @relation(fields: [batchId], references: [id])
  sellerId       String
  walletId       String
  referenceNo    String      @unique
  amountMinor    Int
  status         String      @default("processing") // processing | paid | failed
  method         String      @default("manual_csv") // bank_transfer | manual_csv
  bankAccountId  String?
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id])
  providerRef    String?
  statementJson  String      @default("{}")
  failReason     String?
  paidAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model BankAccount {
  id                   String    @id @default(cuid())
  sellerId             String
  seller               Seller    @relation(fields: [sellerId], references: [id])
  holderName           String
  bankName             String
  accountNumberMasked  String
  accountNumberEnc     String
  verified             Boolean   @default(false)
  verifiedAt           DateTime?
  payouts              Payout[]
  createdAt            DateTime  @default(now())
}

// ---------------------------------------------------------------- G: MARKETING

model Coupon {
  id              String    @id @default(cuid())
  scope           String    @default("platform") // platform | store
  storeId         String?
  store           Store?    @relation(fields: [storeId], references: [id])
  code            String    @unique
  description     String?
  type            String    @default("percent") // percent | fixed | freeship
  percent         Float?
  amountMinor     Int?
  minSpendMinor   Int       @default(0)
  maxRedemptions  Int?
  perCustomerLimit Int      @default(1)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  timesUsed       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CouponRedemption {
  id            String  @id @default(cuid())
  couponId      String
  orderId       String
  customerEmail String
  discountMinor Int
  createdAt     DateTime @default(now())
}

// Shopper address book. Dual ownership: guest checkout saves against the device
// token (ownerToken); once the shopper signs in on that device the rows are
// claimed into the account (shopperId) so addresses follow the ACCOUNT, not the
// browser — signing into a different account never exposes another person's book.
model Address {
  id         String       @id @default(cuid())
  ownerToken String
  shopperId  String?
  shopper    ShopperUser? @relation(fields: [shopperId], references: [id], onDelete: Cascade)
  label      String   @default("Home")
  name       String
  phone      String?
  line1      String
  city       String
  state      String
  postcode   String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerToken])
  @@index([shopperId])
}

// ---------------------------------------------------------------- B3: BUYER DASHBOARD

// Buyer wallet — one per shopper. Money = Int minor units (cents).
model ShopperWallet {
  id                  String       @id @default(cuid())
  userId              String       @unique
  user                ShopperUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceMinor        Int          @default(0)  // SHOPMESH Pay balance
  coinBalance         Int          @default(0)  // loyalty coins (1 coin ≈ RM0.01 redeemable)
  spayLaterLimitMinor Int          @default(0)  // approved credit limit
  spayLaterUsedMinor  Int          @default(0)  // outstanding SPayLater usage
  lastCheckInAt       DateTime?    // last daily coin check-in (24h gate)
  checkInStreak       Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

// Platform-wide voucher pool shoppers can hold via UserVoucher.
model Voucher {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String
  kind            String   @default("discount") // discount | freeshipping | coinsback
  discountMinor   Int      @default(0)  // flat RM off (discount kind)
  percentOff      Int?     // e.g. 10 = 10% off (discount kind)
  maxDiscountMinor Int?    // cap for percent-off vouchers
  minSpendMinor   Int      @default(0)
  expiryAt        DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  holders         UserVoucher[]
}

// A voucher held by a shopper.
model UserVoucher {
  id         String      @id @default(cuid())
  userId     String
  user       ShopperUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  voucherId  String
  voucher    Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  status     String      @default("AVAILABLE") // AVAILABLE | USED | EXPIRED
  claimedAt  DateTime    @default(now())
  usedAt     DateTime?

  @@unique([userId, voucherId])
  @@index([userId, status])
}

// Buyer activity feed — powers My Likes / Recently Viewed and recommendations.
model UserActivity {
  id           String       @id @default(cuid())
  userId       String
  user         ShopperUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  activityType String       // LIKE | VIEWED
  createdAt    DateTime     @default(now())

  @@unique([userId, productId, activityType])
  @@index([userId, activityType])
}

model MarketplaceBanner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model FeaturedSlot {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  slot      String   @default("home_grid")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- H: INTEGRATIONS & OPS

model StoreIntegration {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  provider    String // meta_pixel | ga4 | tiktok_pixel | gtm
  configJson  String   @default("{}")
  isEnabled   Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([storeId, provider])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  url       String
  secret    String
  eventsJson String  @default("[\"order.paid\"]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id            String   @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event         String
  payloadJson   String
  status        String   @default("pending") // pending | success | failed | dead
  attempts      Int      @default(0)
  responseCode  Int?
  lastAttemptAt DateTime?
  createdAt     DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  name       String
  prefix     String
  hash       String
  scopesJson String    @default("[\"read\"]")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model Setting {
  key         String   @id
  valueJson   String
  description String?
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  key             String  @id
  description     String?
  isEnabled       Boolean @default(false)
  rolloutPercent  Int     @default(100)
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  entityType String
  entityId   String?
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorType  String // admin | seller | system | shopper
  actorId    String?
  actorLabel String?
  action     String
  entityType String?
  entityId   String?
  metaJson   String?
  createdAt  DateTime @default(now())
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  event     String
  channel   String // email | whatsapp | inapp
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([event, channel])
}

model NotificationLog {
  id         String   @id @default(cuid())
  event      String
  channel    String
  recipient  String
  subject    String?
  status     String   @default("queued") // queued | sent | failed
  error      String?
  createdAt  DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(cuid())
  storeId     String?
  sellerEmail String?
  subject     String
  status      String   @default("open") // open | pending | closed
  priority    String   @default("normal") // low | normal | high | urgent
  contextType String?
  contextId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    SupportMessage[]
}

model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType  String // admin | seller
  authorLabel String
  body        String
  createdAt   DateTime @default(now())
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String?
  audience  String    @default("all") // all | sellers | admins
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model ExportJob {
  id         String    @id @default(cuid())
  type       String
  status     String    @default("queued") // queued | running | done | failed
  paramsJson String    @default("{}")
  rowCount   Int       @default(0)
  fileUrl    String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
}

// ------------------------------------------------- MARKETPLACE IMPORT (Phase 4)

model MarketplaceConnection {
  id              String    @id @default(cuid())
  storeId         String?   // bound after store claim / for seller-scoped connections
  store           Store?    @relation(fields: [storeId], references: [id])
  platform        String    // shopee | tiktok
  status          String    @default("pending") // pending | authorising | connected | expired | disconnected | needs_credentials
  envConfigured   Boolean   @default(false) // platform app credentials present server-side
  shopId          String?   // source shop identifier (shopee shop_id / tiktok shop_id)
  shopName        String?
  shopCipher      String?   // tiktok shop_cipher (required by product APIs)
  region          String?   // e.g. MY
  accessTokenEnc  String?   // AES-256-GCM encrypted — never returned via API
  refreshTokenEnc String?   // AES-256-GCM encrypted
  scopesJson      String    @default("[]")
  expiresAt       DateTime?
  lastRefreshAt   DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  jobs            ImportJob[]

  @@unique([platform, shopId])
  @@index([storeId])
}

model ImportJob {
  id              String    @id @default(cuid())
  // public tracking token so a guest can watch progress without an account
  trackingToken   String    @unique
  storeId         String?
  store           Store?    @relation(fields: [storeId], references: [id])
  connectionId    String?
  connection      MarketplaceConnection? @relation(fields: [connectionId], references: [id])
  platform        String    // shopee | tiktok | fixture
  inputUrl        String
  urlType         String    @default("unknown") // shop | product | unknown
  sourceShopId    String?
  sourceProductId String?   // set when the pasted URL is a single product
  // queued | validating | awaiting_authorisation | connecting | fetching_shop |
  // importing_products | importing_variants | processing_images | generating_seo |
  // generating_storefront | awaiting_claim | completed | completed_with_warnings | failed
  status          String    @default("queued")
  phaseDetail     String?
  progressJson    String    @default("{}") // {discovered, processed, succeeded, skipped, failed, imagesCopied}
  errorJson       String    @default("{}") // {code, message}
  summaryJson     String    @default("{}") // shop info + limitations found during import
  isFixture       Boolean   @default(false)
  storeCreated    Boolean   @default(false)
  claimedById     String?   // seller id after claim links job → store
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items           ImportJobItem[]

  @@index([status])
  @@index([platform, createdAt])
}

model ImportJobItem {
  id              String    @id @default(cuid())
  jobId           String
  job             ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id])
  sourcePlatform  String
  sourceShopId    String?
  sourceProductId String
  title           String?
  // pending | ok | skipped | failed
  status          String    @default("pending")
  error           String?
  warningsJson    String    @default("[]") // e.g. ["description missing at source","variant price unavailable"]
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([jobId, sourcePlatform, sourceProductId])
  @@index([jobId, status])
}

model StoreClaim {
  id                   String    @id @default(cuid())
  storeId              String
  store                Store     @relation(fields: [storeId], references: [id])
  jobId                String?   // import job that produced the store
  tokenHash            String    @unique // sha256(token) — raw token never stored
  // active | used | expired | revoked
  status               String    @default("active")
  verificationMethod   String    @default("pending") // pending | oauth_shopee | oauth_tiktok | claim_code | admin_manual
  verificationResultJson String  @default("{}")
  expiresAt            DateTime
  usedById             String?   // seller id that claimed
  usedAt               DateTime?
  createdAt            DateTime  @default(now())

  @@index([storeId, status])
}

model SeoMeta {
  id                 String   @id @default(cuid())
  entityType         String   // store | product | category
  entityId           String
  seoTitle           String?
  seoDescription     String?
  ogImage            String?
  canonicalUrl       String?
  noindex            Boolean  @default(false)
  structuredDataJson String   @default("{}")
  lockedFieldsJson   String   @default("[]") // ["seoTitle", ...] — protected from re-import
  warningsJson       String   @default("[]")
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([entityType])
}
