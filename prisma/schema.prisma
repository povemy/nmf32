model MarketplaceConnection {
  id              String      @id @default(cuid())
  storeId         String?
  // PHASE 2.2 (C3 — OAuth ownership): the seller whose OAuth flow created
  // this connection. Written by the platform OAuth callback (from the signed
  // `state`), scoped by the import runner and claim/bind so one seller can
  // never import through or capture another seller's marketplace connection.
  // Plain column (no FK — same loose-reference pattern as
  // AffiliateCommissionEntry.payoutId). See migration 20261105000000.
  sellerId        String?
  platform        String
  status          String      @default("pending")
  envConfigured   Boolean     @default(false)
  shopId          String?
  shopName        String?
  shopCipher      String?
  region          String?
  accessTokenEnc  String?
  refreshTokenEnc String?
  scopesJson      String      @default("[]")
  expiresAt       DateTime?
  lastRefreshAt   DateTime?
  lastError       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  jobs            ImportJob[]
  store           Store?      @relation(fields: [storeId], references: [id])

  @@unique([platform, shopId])
  @@index([storeId])
  @@index([sellerId])
}

model ImportJob {
  id              String                 @id @default(cuid())
  trackingToken   String                 @unique
  storeId         String?
  connectionId    String?
  platform        String
  inputUrl        String
  urlType         String                 @default("unknown")
  sourceShopId    String?
  status          String                 @default("queued")
  phaseDetail     String?
  progressJson    String                 @default("{}")
  errorJson       String                 @default("{}")
  summaryJson     String                 @default("{}")
  isFixture       Boolean                @default(false)
  storeCreated    Boolean                @default(false)
  claimedById     String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sourceProductId String?
  connection      MarketplaceConnection? @relation(fields: [connectionId], references: [id])
  store           Store?                 @relation(fields: [storeId], references: [id])
  items           ImportJobItem[]

  @@index([status])
  @@index([platform, createdAt])
}

model ImportJobItem {
  id              String    @id @default(cuid())
  jobId           String
  productId       String?
  sourcePlatform  String
  sourceShopId    String?
  sourceProductId String
  title           String?
  status          String    @default("pending")
  error           String?
  warningsJson    String    @default("[]")
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  product         Product?  @relation(fields: [productId], references: [id])
  job             ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourcePlatform, sourceProductId])
  @@index([jobId, status])
}

model StoreClaim {
  id                     String    @id @default(cuid())
  storeId                String
  jobId                  String?
  tokenHash              String    @unique
  status                 String    @default("active")
  verificationMethod     String    @default("pending")
  verificationResultJson String    @default("{}")
  expiresAt              DateTime
  usedById               String?
  usedAt                 DateTime?
  createdAt              DateTime  @default(now())
  store                  Store     @relation(fields: [storeId], references: [id])

  @@index([storeId, status])
}

model SeoMeta {
  id                 String   @id @default(cuid())
  entityType         String
  entityId           String
  seoTitle           String?
  seoDescription     String?
  ogImage            String?
  canonicalUrl       String?
  noindex            Boolean  @default(false)
  structuredDataJson String   @default("{}")
  lockedFieldsJson   String   @default("[]")
  warningsJson       String   @default("[]")
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([entityType])
}

// ============================================================================
// SELLER CUSTOMIZATION — cart drawer experience + product card typography.
// Vendors configure these through plain forms in the Seller Backend (toggles,
// selects, pickers). The *_Json columns are BACKEND-ONLY storage written by
// those forms — the vendor UI never edits raw JSON.
// ============================================================================

// Shopify-style cart drawer customization, one per store. The shopper-facing
// drawer (/cart drawer + PDP auto-open) renders from these settings, so the
// seller can add AOV boosters (free-shipping progress, upsells) and urgency
// (low-stock, live viewers, reservation countdown) without any code.
model CartSettings {
  id                      String   @id @default(cuid())
  storeId                 String   @unique
  // drawer structure: compact | standard | pro (image-led, sections, full AOV)
  layout                  String   @default("standard")
  // AOV — free shipping progress bar
  showFreeShippingBar     Boolean  @default(true)
  freeShipThresholdMinor  Int      @default(10000)
  // AOV — upsell / cross-sell strip (auto best-sellers or manual picks)
  upsellEnabled           Boolean  @default(false)
  upsellMode              String   @default("auto") // auto | manual
  upsellProductIdsJson    String   @default("[]")   // backend-only storage
  upsellTitle             String   @default("Frequently bought together")
  upsellLimit             Int      @default(3)
  // urgency — low stock warning
  urgencyStockEnabled     Boolean  @default(false)
  urgencyStockThreshold   Int      @default(5)
  // urgency — simulated live viewers
  urgencyViewersEnabled   Boolean  @default(false)
  urgencyViewersMin       Int      @default(8)
  urgencyViewersMax       Int      @default(28)
  // urgency — cart reservation countdown (minutes from drawer open)
  urgencyCountdownEnabled Boolean  @default(false)
  urgencyCountdownMinutes Int      @default(15)
  // trust / conversion extras
  trustBadgesJson         String   @default("[]")   // backend-only storage
  showOrderNote           Boolean  @default(false)
  showDiscountHint        Boolean  @default(true)
  checkoutLabel           String   @default("Checkout")
  showContinueShopping    Boolean  @default(true)
  stickyCta               Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  store                   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Typography of product cards across the seller's own storefront catalogue:
// font family / size / alignment for the product name and the price.
model ProductCardStyle {
  id         String   @id @default(cuid())
  storeId    String   @unique
  nameFont   String   @default("inter") // FONT ids from src/lib/fonts.ts
  nameSize   String   @default("md")    // sm | md | lg
  nameAlign  String   @default("left")  // left | center | right
  priceFont  String   @default("inter")
  priceSize  String   @default("md")    // sm | md | lg
  priceAlign String   @default("left")  // left | center | right
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Seller Store Insights — append-only analytics event log.
// Filled by src/lib/analytics/* (fire-and-forget, dedupKey-idempotent queue).
// Purchase/refund/revenue metrics are NOT stored here — they are derived from
// authoritative Order/OrderItem/Refund records (see docs/seller-insights/
// metric-definitions.md). Retention: analytics.retention_days (Setting), purged
// by the /api/cron/analytics-tick scheduler endpoint.
// ---------------------------------------------------------------------------
model AnalyticsEvent {
  id           String   @id @default(cuid())
  // Idempotency key: identical deliveries/retries converge to one row
  // (unique + createMany skipDuplicates).
  dedupKey     String   @unique
  eventType    String // store_view | product_view | view_cart | add_to_cart | remove_from_cart
  storeId      String
  productId    String?
  variantId    String?
  // Present only when the actor was authenticated at event time.
  shopperId    String?
  // Pseudonymous first-party cookie identities (no IP, no UA, no PII).
  visitorId    String?
  sessionId    String?
  // Units delta for cart events (add = post-pre; remove = qty removed).
  qty          Int?
  // Referrer host only (≤100 chars) — full URLs are never stored.
  referrerHost String?
  channel      String? // direct | search | social | internal | other
  // Marketing attribution state at event time (validated UTM values and/or a
  // resolved seller campaign-link token — see lib/analytics/attribution.ts).
  // All nullable: untagged traffic and pre-feature history stay null. Plain
  // strings (no FK) by design — rows are purged by the retention rule.
  campaignId   String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  // AFFILIATE — advisory attribution only (money-grade attribution lives in
  // AffiliateAttributionTouch + OrderItem snapshots). Populated from the
  // httpOnly nm_aff_last cookie resolved at event time (lib/analytics/track.ts
  // base()); plain strings (no FK) matching the campaign columns' style.
  affiliateId     String?
  affiliateLinkId String?
  createdAt    DateTime @default(now())

  @@index([storeId, eventType, createdAt])
  @@index([storeId, createdAt])
  @@index([campaignId, createdAt])
  @@index([affiliateId, eventType, createdAt])
}

// Seller-generated campaign tracking links (Marketing Intelligence).
// A seller names a campaign → gets a shareable storefront URL carrying the
// campaign token (`nmcl`) + validated UTM parameters. `code` is globally
// unique (URL-safe short token); `slug` is unique per store and doubles as
// the suggested `utm_campaign` value in generated links. Plain storeId (no
// FK) matches the AnalyticsEvent style — ownership is enforced at query level.
model SellerCampaign {
  id            String   @id @default(cuid())
  storeId       String
  name          String
  slug          String
  code          String   @unique
  // Suggested utm_source / utm_medium stamped into generated links (optional).
  defaultSource String?
  defaultMedium String?
  status        String   @default("active") // active | archived
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
}

// ===========================================================================
// AFFILIATE HUB & ONE-LEVEL SPONSOR REFERRAL SYSTEM
// docs/affiliate/*.md — audit, plan, commission definitions, security rules.
//
// Commercial model: seller-funded commission pool per eligible OrderItem
// (rate in basis points, product override ?? store default, platform max
// enforced); fixed 90/10 split of the POOL (S = floor(P*10/100), D = P - S;
// no sponsor ⇒ D = P); commission attribution travels UP exactly one
// generation; no recruitment/click/registration rewards of any kind.
//
// Money integrity: pool snapshots freeze on OrderItem at checkout (same
// contract as platform commission); AffiliateCommission rows post ONCE per
// order item at payment confirmation (unique orderItemId = idempotency);
// every mutation rides the existing immutable ledger (T1 gains a 4th line,
// T5 gains an affiliate reversal line, new affiliate payout recipes).
// ===========================================================================

// Affiliate identity — one per ShopperUser. An affiliate is an ordinary
// registered user: NO seller status or store ownership required.
model AffiliateProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  // active | suspended | terminated (suspension holds NEW commission; the
  // sponsor share of in-flight pools is held separately — never the direct
  // promoter's 90%).
  status          String    @default("active")
  // Globally-unique referral code (?ref=) — unpredictable random token.
  code            String    @unique
  // Public showcase slug (?aff=) — unique, URL-safe, user-chosen/derived.
  slug            String    @unique
  displayName     String
  bio             String?
  avatarUrl       String?
  // Payout eligibility (manual payout workflow): display-only reference the
  // affiliate provides (e.g. bank nickname/last-4); admins record the actual
  // transfer reference on the payout row. Verified by finance review.
  payoutRef       String?
  payoutVerifiedAt DateTime?
  // Affiliate terms acceptance (version + timestamp) — required at activation.
  termsVersion    Int       @default(1)
  termsAcceptedAt DateTime
  activatedAt     DateTime  @default(now())
  suspendedAt     DateTime?
  suspendedReason String?
  // ---- ONE-LEVEL SPONSOR (nullable self-FK: 0 or 1 sponsor, never more) ----
  // Immutable after activation except through the audited admin correction
  // route (AffiliateSponsorAudit). No cycles are possible: a sponsor must be
  // an ACTIVE affiliate BEFORE the referral activates, so a cycle would
  // require time travel. Self-sponsor is rejected at assignment.
  sponsorId       String?
  sponsorAssignedAt DateTime?
  sponsorSource   String? // referral_touch | code_entry | admin_correction
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            ShopperUser @relation(fields: [userId], references: [id])
  sponsor         AffiliateProfile? @relation("SponsorRefs", fields: [sponsorId], references: [id])
  referrals       AffiliateProfile[] @relation("SponsorRefs")
  // Read-model relations for admin/public queries (scalar FKs above).
  commissionsDirect AffiliateCommission[] @relation("AffiliateCommissionDirect")
  payouts           AffiliatePayout[]
  collections       AffiliateCollection[]

  @@index([sponsorId])
  @@index([status])
}

// Immutable audit trail for every sponsor relationship change. Rows are
// append-only; admin corrections REQUIRE a documented reason.
model AffiliateSponsorAudit {
  id            String   @id @default(cuid())
  affiliateId   String
  fromSponsorId String?
  toSponsorId   String?
  reason        String
  actorType     String // admin
  actorId       String
  createdAt     DateTime @default(now())

  @@index([affiliateId, createdAt])
}

// Registration attribution — FIRST valid referral touch wins (30-day window).
// The click itself creates NO relationship and pays NOTHING; the sponsor is
// only recorded when the invited user completes affiliate activation
// (POST /api/affiliate/activate validates the nm_aff_ref cookie against this
// table). The cookie is only set when no valid touch exists yet (first-touch).
model AffiliateReferralTouch {
  id            String    @id @default(cuid())
  code          String
  affiliateId   String
  visitorId     String
  channel       String?
  touchedAt     DateTime  @default(now())
  expiresAt     DateTime
  // Filled when a user activates using this touch (exactly once).
  consumedAt    DateTime?
  consumedUserId String?
  createdAt     DateTime  @default(now())

  @@index([affiliateId, touchedAt])
  @@index([visitorId, touchedAt])
}

// Promotional links — product | store | collection | showcase. `code` is an
// unpredictable random token carried in the URL (?al=). Channel labels are
// reporting metadata ONLY — they never change the commission split.
model AffiliateLink {
  id            String    @id @default(cuid())
  affiliateId   String
  type          String // product | store | collection | showcase
  code          String    @unique
  productId     String?
  storeId       String?
  collectionId  String?
  // Reporting label for the external channel (tiktok|threads|facebook|
  // telegram|whatsapp|blog|website|other) — no account connection implied.
  channel       String    @default("other")
  label         String?
  status        String    @default("active") // active | archived
  clicks        Int       @default(0)
  lastClickAt   DateTime?
  createdAt     DateTime  @default(now())
  archivedAt    DateTime?

  @@index([affiliateId, createdAt])
  @@index([status, code])
}

// Curated product collections (promotional content, NOT a seller catalogue).
// `version` bumps on membership edits so attribution touches can snapshot the
// membership scope they were validated against — later edits never rewrite
// past attribution.
model AffiliateCollection {
  id            String    @id @default(cuid())
  affiliateId   String
  title         String
  description   String?
  slug          String    @unique
  status        String    @default("draft") // draft | published | archived
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?
  archivedAt    DateTime?
  // POST-IMPLEMENTATION AUDIT (defect fix): the public collection route
  // (api/affiliate/pub/collection/[slug]) includes this relation but it was
  // missing from the schema — a phantom relation that would throw at runtime
  // the moment the deferred collections gate is re-enabled. Declared properly
  // here (+ its FK in migration 20261031000001).
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id])
  items         AffiliateCollectionItem[]

  @@index([affiliateId, status])
}

model AffiliateCollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  position     Int      @default(0)
  addedAt      DateTime @default(now())
  collection   AffiliateCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id])

  @@unique([collectionId, productId])
  @@index([productId])
}

// Product-sale attribution touches — LAST eligible click wins, per PRODUCT,
// keyed by the httpOnly first-party visitor cookie (nm_ins_vid). Recorded
// server-side on link resolution; the client never supplies affiliate ids.
// Scope rows:
//   product link  → productId set (scope = that product)
//   store link    → storeId set, productId null (scope = that store's eligible products)
//   collection    → collectionId + scopeProductIds JSON snapshot (scope = the
//                   member products AT CLICK TIME with the collection version)
//   showcase      → a showcase VISIT row has no product scope (attributes
//                   nothing by itself); products clicked inside the showcase
//                   record PRODUCT-scope rows via the same tracking endpoint.
model AffiliateAttributionTouch {
  id              String   @id @default(cuid())
  visitorId       String
  affiliateId     String
  linkId          String
  linkType        String // product | store | collection | showcase
  productId       String?
  storeId         String?
  collectionId    String?
  collectionVersion Int?
  scopeProductIds String? // JSON array snapshot (collection links)
  channel         String?
  clickedAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([visitorId, productId, clickedAt])
  @@index([visitorId, storeId, clickedAt])
  @@index([affiliateId, clickedAt])
  @@index([clickedAt])
}

// Commission POOL record — exactly ONE per attributed OrderItem (unique
// orderItemId = the idempotency guarantee: duplicate webhooks / retries can
// never double-post). All monetary fields are frozen snapshots of the
// checkout-time OrderItem columns; the 90/10 SPLIT is computed at posting
// from the then-current sponsor-override flag + sponsor eligibility (never
// rewritten afterwards).
model AffiliateCommission {
  id                    String   @id @default(cuid())
  orderItemId           String   @unique
  orderId               String
  orderNumber           String
  storeId               String
  productId             String?
  // Direct affiliate + their one-level sponsor AT CHECKOUT (snapshot).
  affiliateId           String
  sponsorId             String?
  linkId                String?
  linkType              String?
  channel               String?
  // Frozen financials (mirror the OrderItem snapshot).
  commissionableBaseMinor Int
  rateBps               Int
  poolMinor             Int
  currency              String   @default("MYR")
  attributionPolicy     String   @default("v1:lc30d")
  status                String   @default("pending") // pending|approved|available|paid|reversed|held
  createdAt             DateTime @default(now())
  approvedAt            DateTime?
  paidAt                DateTime?
  reversedAt            DateTime?
  breakdownJson         String   @default("{}")
  entries               AffiliateCommissionEntry[]
  affiliate             AffiliateProfile @relation("AffiliateCommissionDirect", fields: [affiliateId], references: [id])
  order                 Order            @relation(fields: [orderId], references: [id])

  @@index([affiliateId, createdAt])
  @@index([sponsorId, createdAt])
  @@index([orderId])
  @@index([status, createdAt])
  @@index([storeId, createdAt])
}

// Beneficiary allocations — AT MOST TWO rows per commission (unique
// commissionId+role): direct (90%) and sponsor (10%). Independent status so
// a sponsor under review can be HELD without touching the direct promoter's
// legitimate 90%. `availableAt` is the pending→available maturity clock
// (approvedAt + affiliate.review_days).
model AffiliateCommissionEntry {
  id                     String   @id @default(cuid())
  commissionId           String
  beneficiaryAffiliateId String
  role                   String // direct | sponsor
  amountMinor            Int
  status                 String   @default("pending") // pending|approved|available|paid|reversed|held
  reversedMinor          Int      @default(0)
  availableAt            DateTime?
  holdReason             String?
  paidAt                 DateTime?
  payoutId               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  commission             AffiliateCommission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@unique([commissionId, role])
  @@index([beneficiaryAffiliateId, status])
  @@index([status, availableAt])
  @@index([payoutId])
}

// Affiliate payout — MANUAL controlled workflow (the audited reality: no
// automated PSP payout capability exists; finance executes transfers from
// bank evidence and records the reference here). State machine mirrors the
// seller Payout flow: requested → processing → paid | failed; requested →
// rejected. Ledger: T-A3 on approve, T-A4 on mark-paid, T-A4f on fail.
model AffiliatePayout {
  id            String   @id @default(cuid())
  affiliateId   String
  amountMinor   Int
  currency      String   @default("MYR")
  status        String   @default("requested") // requested|processing|paid|failed|rejected
  method        String   @default("manual_bank")
  reference     String? // bank/PSP transfer reference recorded by finance
  note          String?
  failReason    String?
  // Ledger-derived statement (entries covered, balances) — built from
  // AffiliateCommissionEntry rows at request/approve time, never hand-edited.
  statementJson String   @default("{}")
  requestedAt   DateTime @default(now())
  processedAt   DateTime?
  processedBy   String? // admin user id
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId, status])
  @@index([status, requestedAt])
  // PHASE 2.2 (C1.2): DB-level protection against duplicate open payout
  // requests — a PARTIAL UNIQUE INDEX (not expressible in Prisma DSL; created
  // by migration 20261105000000):
  //   CREATE UNIQUE INDEX "AffiliatePayout_one_open_per_affiliate"
  //     ON "AffiliatePayout"("affiliateId")
  //     WHERE status IN ('requested','processing');
  // The application layer additionally uses Serializable isolation +
  // conditional claims (requestAffiliatePayout) — the index is the hard
  // backstop for non-transactional writers.
}
